# Clerk (obligatoire)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# --- Dev local (npm run dev) ---
# Appels via proxy Vite /api → Back port 8000. Ne pas pointer vers la prod.
VITE_PROXY_TARGET=http://localhost:8000
VITE_API_BASE_URL=

# --- Production (Vercel) ---
# VITE_PROXY_TARGET=
# VITE_API_BASE_URL=https://api-regtech.efymotors.com
# Même instance Clerk que le Back (pk_live_… côté front, CLERK_* côté Back).

# NewsAPI.org — landing section « Latest customs & AfCFTA news » (below hero)
# Get a free key: https://newsapi.org/register — do NOT commit the real key.
# Dev: Vite serves GET /api/trade-news (see vite.config.ts + shared/tradeNewsCore.ts)
# Vercel prod: set NEWS_API_KEY in project env → api/trade-news.ts
# Custom host (efymotors): same env + ensure /api/trade-news is routed to the serverless handler
NEWS_API_KEY=
